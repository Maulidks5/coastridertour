APP_NAME="Coast Rider Tour Company Limited"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://coastridertour.com
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=coastridertour_db
DB_USERNAME=coastridertour_user
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
PUBLIC_STORAGE_ROOT=/home2/coastridertour/public_html/storage
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.coastridertour.com
MAIL_PORT=465
MAIL_USERNAME=info@coastridertour.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=info@coastridertour.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=info@coastridertour.com

ADMIN_NAME="Coast Rider Administrator"
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

VITE_APP_NAME="${APP_NAME}"
